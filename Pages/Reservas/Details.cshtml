@page
@model Gest_oEquipamentos.Pages.Reservas.DetailsModel

@{
    ViewData["Title"] = "Detalhes da Reserva";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card card-dark-blue shadow-lg">
                <div class="card-header border-bottom border-secondary py-3">
                    <h2 class="mb-0 fs-4 fw-bold">🔍 Detalhes da Reserva</h2>
                </div>
                <div class="card-body">
                    <dl class="row my-3">
                        <dt class="col-sm-4 fw-bold mb-3">Professor</dt>
                        <dd class="col-sm-8 mb-3 text-professor-highlight fw-bold">
                            @Html.DisplayFor(model => model.Reserva.NomeProfessorBeneficiario)
                        </dd>

                        <dt class="col-sm-4 fw-bold mb-3">Sala</dt>
                        <dd class="col-sm-8 mb-3">@Html.DisplayFor(model => model.Reserva.Sala)</dd>

                        <dt class="col-sm-4 fw-bold mb-3">Data e Horário</dt>
                        <dd class="col-sm-8 mb-3">@Html.DisplayFor(model => model.Reserva.Data)</dd>

                        <dt class="col-sm-4 fw-bold mb-3">Período</dt>
                        <dd class="col-sm-8 mb-3">@Html.DisplayFor(model => model.Reserva.Periodo)</dd>

                        <dt class="col-sm-4 fw-bold mb-3">Status</dt>
                        <dd class="col-sm-8 mb-3">
                            <span class="badge bg-transparent border border-warning text-warning">
                                @Html.DisplayFor(model => model.Reserva.Status)
                            </span>
                        </dd>

                        <dt class="col-sm-4 fw-bold mb-3">Equipamentos Solicitados</dt>
                        <dd class="col-sm-8 mb-3">
                            <div class="d-flex flex-column gap-2">
                                @foreach (var item in Model.Reserva.ItensReserva)
                                {
                                    <div>
                                        <span class="badge border border-secondary text-white bg-transparent fs-6">
                                            📦 @item.Equipamento?.Nome x @item.Quantidade
                                        </span>
                                    </div>
                                }
                            </div>
                        </dd>
                    </dl>

                    <hr class="border-secondary my-4" />

                    <div class="d-flex gap-2">
                        <a asp-page="./Edit" asp-route-id="@Model.Reserva.Id" class="btn btn-outline-edit px-4">Editar Reserva</a>
                        <a asp-page="./Index" class="btn btn-outline-back px-4">Voltar para a Lista</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>