@page
@model Gest_oEquipamentos.Pages.Reservas.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Lista de Reservas";
}

<div class="container mt-4">
    <h2>Lista de Reservas</h2>

    <p>
        <a asp-page="Create" class="btn btn-primary">Criar Nova Reserva</a>
    </p>

    <table class="table table-striped table-hover mt-3">
        <!-- Aqui continua o resto do seu código original (thead, tbody, o loop foreach, etc.) -->    <a asp-page="Create">Create New</a>
</p>
<table class="table table-striped table-hover mt-4">    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Reserva[0].AssistenteId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reserva[0].NomeProfessorBeneficiario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reserva[0].Sala)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reserva[0].Equipamento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reserva[0].Data)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reserva[0].Periodo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reserva[0].Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Reserva) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.AssistenteId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NomeProfessorBeneficiario)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sala)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Equipamento.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Data)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Periodo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>            </td>
        </tr>
}
    </tbody>
</table>
</div>