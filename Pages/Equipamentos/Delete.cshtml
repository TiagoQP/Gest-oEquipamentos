@page
@model Gest_oEquipamentos.Pages.Equipamentos.DeleteModel

@{
    ViewData["Title"] = "Excluir Equipamento";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-dark-blue shadow-lg border border-danger">
                <div class="card-header border-bottom border-danger py-3">
                    <h2 class="mb-0 fs-4 fw-bold text-danger">⚠️ Confirmar Exclusão de Equipamento</h2>
                </div>
                <div class="card-body">
                    <div class="alert bg-transparent border border-warning text-warning mb-4" role="alert">
                        <strong>Atenção!</strong> Você tem certeza de que deseja remover permanentemente este equipamento? Certifique-se de que não existem reservas pendentes atreladas a ele.
                    </div>

                    <dl class="row my-3">
                        <dt class="col-sm-5 fw-bold mb-3">
                            Nome do Equipamento
                        </dt>
                        <dd class="col-sm-7 mb-3 text-professor-highlight fw-bold">
                            @Html.DisplayFor(model => model.Equipamento.Nome)
                        </dd>

                        <dt class="col-sm-5 fw-bold mb-3">
                            Quantidade Total
                        </dt>
                        <dd class="col-sm-7 mb-3">
                            <span class="badge border border-secondary text-white bg-transparent fs-6">
                                @Html.DisplayFor(model => model.Equipamento.QuantidadeTotal)
                            </span>
                        </dd>

                        <dt class="col-sm-5 fw-bold mb-3">
                            Quantidade Disponível
                        </dt>
                        <dd class="col-sm-7 mb-3">
                            <span class="badge border border-secondary text-white bg-transparent fs-6">
                                @Html.DisplayFor(model => model.Equipamento.QuantidadeDisponivel)
                            </span>
                        </dd>
                    </dl>

                    <hr class="border-secondary my-4" />

                    <form method="post">
                        <!-- Campo oculto crucial para o EF saber qual registro deletar -->
                        <input type="hidden" asp-for="Equipamento.Id" />
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-outline-table-delete px-4 fw-bold">Sim, Excluir</button>
                            <a asp-page="./Index" class="btn btn-outline-back px-4">Cancelar e Voltar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>