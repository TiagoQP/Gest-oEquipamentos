@page
@model Gest_oEquipamentos.Pages.Equipamentos.CreateModel

@{
    ViewData["Title"] = "Cadastrar Equipamento";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-dark-blue shadow-lg">
                <div class="card-header border-bottom border-secondary py-3">
                    <h2 class="mb-0 fs-4 fw-bold">➕ Cadastrar Novo Equipamento</h2>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Equipamento.Nome" class="form-label fw-bold">Nome do Equipamento</label>
                            <input asp-for="Equipamento.Nome" class="form-control" placeholder="Ex: Projetor Dell, Notebook HP..." />
                            <span asp-validation-for="Equipamento.Nome" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Equipamento.QuantidadeTotal" class="form-label fw-bold">Quantidade Total</label>
                            <input asp-for="Equipamento.QuantidadeTotal" class="form-control" type="number" min="0" placeholder="0" />
                            <span asp-validation-for="Equipamento.QuantidadeTotal" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Equipamento.QuantidadeDisponivel" class="form-label fw-bold">Quantidade Disponível</label>
                            <input asp-for="Equipamento.QuantidadeDisponivel" class="form-control" type="number" min="0" placeholder="0" />
                            <span asp-validation-for="Equipamento.QuantidadeDisponivel" class="text-danger"></span>
                        </div>

                        <hr class="border-secondary my-4" />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-outline-save px-4">Confirmar Cadastro</button>
                            <a asp-page="Index" class="btn btn-outline-back px-4">Voltar para a Lista</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}